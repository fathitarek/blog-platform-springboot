SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/blog_platform?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=blog_user
SPRING_DATASOURCE_PASSWORD=blog_password
MYSQL_DATABASE=blog_platform
MYSQL_USER=blog_user
MYSQL_PASSWORD=blog_password
JWT_SECRET=replace-with-a-long-32-plus-character-secret
JWT_ISSUER=blog-platform-springboot
JWT_EXPIRATION_MINUTES=120
APP_CACHE_REDIS_ENABLED=true
